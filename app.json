{
  "expo": {
    "name": "Kind",
    "slug": "kind-mental-health-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "kind",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kind.mentalhealth"
    },
    "android": {
      "package": "com.kind.mentalhealth",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/splash_logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#f5f3ff"
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-notifications"
    ],
    "extra": {
      "apiUrl": "http://10.102.148.69:8080/",
      "appEnv": "local",
      "azureSpeechKey": "",
      "azureSpeechRegion": "",
      "eas": {
        "projectId": "716d97a0-6aaf-4d04-9533-e0047aa22f46"
      }
    }
  }
}